[Unit]
Description=Eneida VPN Agent
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/eneida-agent
EnvironmentFile=/etc/eneida-agent.env
ExecStart=/opt/eneida-agent/.venv/bin/uvicorn agent:app --host 127.0.0.1 --port 8091
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
